# Every variable the code reads. Unset lines fall back to the default noted.

# --- Server ---
PORT=3000                                # HTTP port
NODE_ENV=development                     # "production" enables prod DB path, IndexNow, fatal bundle errors
# DB_PATH=./plane-data.sqlite            # SQLite file (prod default /srv/ua-starlink-tracker/plane-data.sqlite)
# DISABLE_JOBS=1                         # 1 = serve only, no background scraping/verification jobs
LOG_DIR=./logs                           # app.log directory (persistent mount in prod)

# --- Local dev host routing (localhost only) ---
# DEV_SITE=united                        # SITES key to serve on localhost: united | airline | alaska | ...
# DEV_TENANT=UA                          # airline code or ALL; used when DEV_SITE is unset

# --- Upstream data ---
FLIGHT_DATA_SOURCE=flightradar24         # flightradar24 (free) or flightaware (paid, needs AEROAPI_KEY)
# AEROAPI_KEY=                           # FlightAware AeroAPI key
# SHEETS_API_KEY=                        # Google Sheets API key; unlocks per-tail install-pipeline ingest
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers  # Chromium location for FR24/United.com scrapers
# RESIDENTIAL_SYNC_HOST=llc              # SSH host for `bun run residential-sync`
# PREDICTOR_ADSB_DRAWS=on                # off = predictor ignores ADS-B tail draws

# --- Passenger Starlink detection ---
# PASSENGER_VERIFY=probe                 # off disables the on-board probe and banner

# --- Notifications / SEO (unset = disabled) ---
# SLACK_WEBHOOK_URL=                     # new-plane notices
# SLACK_MENTION=<@U07HKUAAD0B>           # mention prepended to Slack notices
# INDEXNOW_KEY=                          # IndexNow key; pings only when NODE_ENV=production

# --- Datadog APM ---
DD_TRACE_ENABLED=false                   # true = start dd-trace
DD_ENV=development                       # dd env tag
DD_SERVICE=ua-starlink-tracker           # dd service tag
# DD_VERSION=                            # dd version tag (default "unknown")
# DD_TRACE_AGENT_HOSTNAME=localhost      # read by dd-trace itself
# DD_TRACE_AGENT_PORT=8126               # read by dd-trace itself
# DD_DOGSTATSD_PORT=8125                 # read by dd-trace itself

# --- Internal (set by code or tests, not by hand) ---
# SUBPROCESS_MODE=1                      # set on the United.com checker child; logs to stderr
# UPDATE_GOLDEN=1                        # regenerate tests/golden/api-contracts.json
# CI / TZ                                # read by tests only
